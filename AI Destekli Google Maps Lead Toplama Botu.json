    {
      "parameters": {
        "jsCode": "const inputText = Simple.first().json.text;\n\n// Cümleleri ayırmak için düzenli ifade (regex)\nconst sentenceRegex = /([.!?])\\s+(?=[A-Z])/;\nconst sentences = inputText\n    .split(sentenceRegex)\n    .map(s => s.trim())\n    .filter(s => s.length > 0);\n\n// Chunk'ları oluşturma\nconst outputChunks = [];\nlet currentChunk = \"\";\nlet sentenceCount = 0;\nconst maxSentences = 3;\nconst maxLength = 500;\n\nfor (let sentence of sentences) {\n    const nextChunk = currentChunk ? `${currentChunk} ${sentence}` : sentence;\n    \n    if (sentenceCount < maxSentences && nextChunk.length <= maxLength) {\n        currentChunk = nextChunk;\n        sentenceCount += 1;\n    } else {\n        if (currentChunk) {\n            outputChunks.push(currentChunk.trim());\n        }\n        currentChunk = sentence;\n        sentenceCount = 1;\n    }\n}\n\nif (currentChunk) {\n    outputChunks.push(currentChunk.trim());\n}\n\n// Return output\nconst outputItems = outputChunks.map((chunk, index) => ({\n    json: {\n        fullText: chunk,\n        index: index\n    }\n}));\n\nreturn outputItems;"
      },
